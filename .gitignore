# ---------------------------------------------------------------
# furui-aios 全局忽略规则
# 原则：只纳管「产品代码 + 文档 + 工程约定」；
#       依赖 / 构建产物 / 密钥 / 日志 / 数据库 / 一次性排查脚本一律不入库。
# ---------------------------------------------------------------

# ---- 依赖与构建产物 ----
node_modules/
.next/
out/
build/
dist/
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# ---- 密钥与环境（第一位，绝不入库）----
.env
.env.*
!.env.example
.env.production
docker-compose.override.yml
*.key
*.pem

# ---- 日志与临时输出 ----
*.log
*.out
*.err
npm-debug.log*
yarn-error.log*

# ---- 数据库与本地存储 ----
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/data/

# ---- 类型 / 构建缓存 ----
*.tsbuildinfo
.tscache/

# ---- 编辑器与系统 ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- 表格抓取原始 dump（sheets/cells-get-<id>-<range>.json，单文件 600KB+）----
sheets/
*.cells-get.json
cells-get-*.json

# ---- 一次性排查脚本（tools_patch / backend 根的调试残留）----
dbg*.db
dbg*.txt
probe_*.py
diagnose_*.py
_verify_t21.py
_rewrite_t14.py
page_*.html
confirm.txt
build_furui_data.py
backend/err.txt
backend/regression_*.txt
backend/inventory_db.py
backend/list_routes.py
backend/migrate_env.py
backend/verify_fix.py
backend/fix_*.py
backend/patch_*.py
backend/test_nuclear_*.py

# ---- Next 历史构建目录（dev 反复重启留下的 .next_old_<ts>）----
.next*/
.build_verify/
.vercel/
