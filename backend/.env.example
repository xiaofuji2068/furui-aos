# ============ 对话模型（多提供方，任选一家填 Key 并设为当前即可） ============
# 也可以在「模型管理」页面配置，效果等同本文件；留空则对话走内置 mock 回复
# 当前激活的对话提供方：deepseek / kimi / qwen / glm / openai / custom
ACTIVE_LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
# Kimi（Moonshot）
KIMI_API_KEY=
# 通义千问（对话）
QWEN_API_KEY=
# 智谱 GLM
GLM_API_KEY=
# OpenAI
OPENAI_API_KEY=
# 自定义（兼容 OpenAI 接口，如企业内网模型）
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL_NAME=

# ============ 语义检索 Embedding（通义 DashScope，RAG 用） ============
# 填入后，知识库检索从"本地哈希向量（离线兜底）"升级为"text-embedding-v3 真实语义向量（1024 维）"，
# 维度一致无需重建索引，随时可填可退。不填则自动降级为本地哈希，离线演示不受影响。
DASHSCOPE_API_KEY=

# ============ 数据库连接 ============
# 不填默认 SQLite（backend/data/app.db，开箱即跑）；生产填 PG 后自动切换，无需改代码：
# DATABASE_URL=postgresql://user:pass@localhost:5432/furui_aios
# 切库后建表/升级走迁移：cd backend && alembic upgrade head（已有开发库用 alembic stamp head）
DATABASE_URL=

# ============ 密钥治理 ============
# 环境变量优先于 .env 文件 —— 生产可从外部 Secret 注入（如容器 Secret / CI 变量），
# 无需改代码；本文件仅作本地开发默认值。
